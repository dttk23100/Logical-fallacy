# Get a key at https://console.anthropic.com/ and copy this file to .env
ANTHROPIC_API_KEY=

# Optional. A smaller model answers faster and costs less, e.g. claude-haiku-5-5
# FALLACY_MODEL=claude-opus-5-5
# PORT=3000

# Optional. A free key from https://console.groq.com switches listening to Whisper,
# which hears far more accurately than the browser's built-in recognition.
# GROQ_API_KEY=
